# LLM Config
OPENAI_API_KEY="" # your api-key here
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# OceanBase Config
OCEANBASE_URI="127.0.0.1:2881"
OCEANBASE_USER="root"
OCEANBASE_PASSWORD=""
OCEANBASE_DBNAME="oceanbase"

# RAG Retrieval Config - 针对40分钟时限优化
TOP_K=20                    # 返回的最大结果数
BM25_CANDIDATES=60          # BM25检索候选数
VEC_CANDIDATES=80           # 向量检索候选数
RRF_K=60                    # RRF融合常数
MAX_CONTEXT_CHARS=20000     # 上下文最大字符数
SIMILARITY_THRESHOLD=0.15   # 向量相似度阈值

# Feature Flags - 关闭耗时功能以满足时限
ENABLE_HYDE=false           # 关闭HyDE以节省LLM调用时间

# Embedding Config
EMBEDDING_DIM=0             # 嵌入维度（0表示自动探测）
VECTOR_METRIC=cosine        # 向量距离度量（l2/ip/cosine）
