# LLM Config
OPENAI_API_KEY="" # your api-key here
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# OceanBase Config
OCEANBASE_URI="127.0.0.1:2881"
OCEANBASE_USER="root"
OCEANBASE_PASSWORD=""
OCEANBASE_DBNAME="oceanbase"

# RAG Retrieval Config
TOP_K=25                    # 返回的最大结果数
BM25_CANDIDATES=125         # BM25检索候选数
VEC_CANDIDATES=200          # 向量检索候选数
RRF_K=60                    # RRF融合常数
MAX_CONTEXT_CHARS=28000     # 上下文最大字符数
SIMILARITY_THRESHOLD=0.15   # 向量相似度阈值

# Feature Flags
ENABLE_HYDE=true            # 是否启用HyDE假设性文档增强
ENABLE_MODEL_RERANK=true    # 是否启用模型重排序（gte-rerank）
ENABLE_LLM_KEYWORDS=false   # 是否启用LLM关键词提取（增加延迟但提升质量）

# Rerank Config
RERANK_BASE_URL="https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank"
RERANK_MODEL="gte-rerank"   # 重排序模型

# Embedding Config
EMBEDDING_DIM=0             # 嵌入维度（0表示自动探测）
VECTOR_METRIC=cosine        # 向量距离度量（l2/ip/cosine）
