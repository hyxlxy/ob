# LLM Config
OPENAI_API_KEY="" # your api-key here
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# OceanBase Config
OCEANBASE_URI="127.0.0.1:2881"
OCEANBASE_USER="root"
OCEANBASE_PASSWORD=""
OCEANBASE_DBNAME="oceanbase"

# RAG Retrieval Config
TOP_K=20                    # 返回的最大结果数
BM25_CANDIDATES=80          # BM25检索候选数
VEC_CANDIDATES=120          # 向量检索候选数
RRF_K=60                    # RRF融合常数
MAX_CONTEXT_CHARS=24000     # 上下文最大字符数
SIMILARITY_THRESHOLD=0.2    # 向量相似度阈值

# Feature Flags
ENABLE_HYDE=true            # 是否启用HyDE假设性文档增强

# Embedding Config
EMBEDDING_DIM=0             # 嵌入维度（0表示自动探测）
VECTOR_METRIC=cosine        # 向量距离度量（l2/ip/cosine）
