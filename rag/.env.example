# LLM Config
OPENAI_API_KEY="" # your api-key here
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# OceanBase Config
OCEANBASE_URI="127.0.0.1:2881"
OCEANBASE_USER="root"
OCEANBASE_PASSWORD=""
OCEANBASE_DBNAME="oceanbase"

# RAG Retrieval Config - 平衡质量和速度
TOP_K=25                    # 返回的最大结果数
BM25_CANDIDATES=100         # BM25检索候选数
VEC_CANDIDATES=150          # 向量检索候选数
RRF_K=60                    # RRF融合常数
MAX_CONTEXT_CHARS=24000     # 上下文最大字符数
SIMILARITY_THRESHOLD=0.15   # 向量相似度阈值

# Feature Flags
ENABLE_HYDE=true            # HyDE对检索质量有帮助

# Embedding Config
EMBEDDING_DIM=0             # 嵌入维度（0表示自动探测）
VECTOR_METRIC=cosine        # 向量距离度量（l2/ip/cosine）
