### 2025-09-10 11:38:33.212
SELECT COSINE_DISTANCE(C1, C2) FROM TEST;
### 2025-09-10 11:38:33.214
SELECT INNER_PRODUCT(C1, C2) FROM TEST;
### 2025-09-10 11:38:33.215
-- 测试向量字面量
### 2025-09-10 11:38:33.215
SELECT [1,2,3] + [4,5,6];
### 2025-09-10 11:38:33.215
SELECT L2_DISTANCE([1,1,1], [2,2,2]);
