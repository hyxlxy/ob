### 2025-09-10 11:38:33.192
-- 测试表达式功能和向量功能
### 2025-09-10 11:38:33.194
-- 创建测试表
### 2025-09-10 11:38:33.194
CREATE TABLE exp_table(id int, col1 int, col2 int, col3 float, col4 float);
### 2025-09-10 11:38:33.194
INSERT INTO exp_table VALUES (8, 3, 4, 2.9, 3.38);
### 2025-09-10 11:38:33.195
INSERT INTO exp_table VALUES (8, 6, 2, 7.09, 5.36);
### 2025-09-10 11:38:33.195
INSERT INTO exp_table VALUES (4, 4, 4, 3.41, 4.5);
### 2025-09-10 11:38:33.195
-- 测试基本表达式功能
### 2025-09-10 11:38:33.196
SELECT * FROM exp_table WHERE col1 - 9 > 9;
### 2025-09-10 11:38:33.198
SELECT * FROM exp_table WHERE col1 + col2 > 5;
### 2025-09-10 11:38:33.200
SELECT * FROM exp_table WHERE col1 * col2 < 20;
### 2025-09-10 11:38:33.201
-- 创建向量测试表
### 2025-09-10 11:38:33.202
CREATE TABLE TEST (ID INT, C1 VECTOR(3), C2 VECTOR(3), C3 VECTOR(4));
### 2025-09-10 11:38:33.202
-- 测试向量插入（字符串格式）
### 2025-09-10 11:38:33.203
INSERT INTO TEST VALUES(1, '[1,1,1]', '[1,2,3]', '[1,2,3,4]');
### 2025-09-10 11:38:33.204
-- 测试向量插入（直接格式）
### 2025-09-10 11:38:33.204
INSERT INTO TEST VALUES(2, [2,2,2], [2,3,4], [2,3,4,5]);
### 2025-09-10 11:38:33.206
-- 测试向量查询
### 2025-09-10 11:38:33.206
SELECT * FROM TEST;
### 2025-09-10 11:38:33.207
-- 测试向量运算
### 2025-09-10 11:38:33.207
SELECT C1 + C2 FROM TEST;
### 2025-09-10 11:38:33.208
SELECT C1 - C2 FROM TEST;
### 2025-09-10 11:38:33.210
SELECT C1 * C2 FROM TEST;
### 2025-09-10 11:38:33.211
-- 测试向量距离函数
### 2025-09-10 11:38:33.211
SELECT L2_DISTANCE(C1, C2) FROM TEST;
### 2025-09-10 11:38:33.212
SELECT COSINE_DISTANCE(C1, C2) FROM TEST;
### 2025-09-10 11:38:33.214
SELECT INNER_PRODUCT(C1, C2) FROM TEST;
### 2025-09-10 11:38:33.215
-- 测试向量字面量
### 2025-09-10 11:38:33.215
SELECT [1,2,3] + [4,5,6];
### 2025-09-10 11:38:33.215
SELECT L2_DISTANCE([1,1,1], [2,2,2]);
