TEST NULL VALUE INSERTION
CREATE TABLE NULL_TEST(ID INT, NAME CHAR(10) NULL, SCORE INT NULL);
SUCCESS

TEST INSERTING NULL VALUES
INSERT INTO NULL_TEST VALUES (1, 'ALICE', 85);
SUCCESS
INSERT INTO NULL_TEST VALUES (2, NULL, 90);
SUCCESS
INSERT INTO NULL_TEST VALUES (3, 'BOB', NULL);
SUCCESS
INSERT INTO NULL_TEST VALUES (4, NULL, NULL);
SUCCESS

CHECK INSERTED DATA
SELECT * FROM NULL_TEST;
ID | NAME | SCORE
1 | ALICE | 85
2 | NULL | 90
3 | BOB | NULL
4 | NULL | NULL

TEST ORDER BY WITH NULL VALUES
SELECT * FROM NULL_TEST ORDER BY SCORE;
ID | NAME | SCORE
1 | ALICE | 85
2 | NULL | 90
3 | BOB | NULL
4 | NULL | NULL

TEST ORDER BY DESC WITH NULL VALUES
SELECT * FROM NULL_TEST ORDER BY SCORE DESC;
ID | NAME | SCORE
4 | NULL | NULL
3 | BOB | NULL
2 | NULL | 90
1 | ALICE | 85

TEST ORDER BY WITH NULL NAME VALUES
SELECT * FROM NULL_TEST ORDER BY NAME;
ID | NAME | SCORE
1 | ALICE | 85
2 | NULL | 90
3 | BOB | NULL
4 | NULL | NULL

CLEAN UP
DROP TABLE NULL_TEST;
SUCCESS
