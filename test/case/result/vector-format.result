VECTOR FORMAT TEST

CREATE TABLE ITEMS(ID INT, EMBEDDING VECTOR(3));
SUCCESS
INSERT INTO ITEMS VALUES (1, '[1.0,2.0,3.0]');
SUCCESS
INSERT INTO ITEMS VALUES (2, '[1.5,2.3,3.3]');
SUCCESS
INSERT INTO ITEMS VALUES (3, '[0,0,0]');
SUCCESS

SELECT * FROM ITEMS;
ID | EMBEDDING
1 | [1,2,3]
2 | [1.5,2.3,3.3]
3 | [0,0,0]

VECTOR LITERAL OPERATIONS
SELECT EMBEDDING + [1.5,2.3,3.3] FROM ITEMS;
EMBEDDING + [1.5,2.3,3.3]
[2,4,6]
[2.5,4.3,6.3]
[1,2,3]
SELECT EMBEDDING - '[1,2,3]' FROM ITEMS;
EMBEDDING - '[1,2,3]'
[0,0,0]
[0.5,0.3,0.3]
[-1,-2,-3]
SELECT [1,2,3] - EMBEDDING FROM ITEMS;
[1,2,3] - EMBEDDING
[0,0,0]
[-0.5,-0.3,-0.3]
[1,2,3]

COMPLEX QUERY
SELECT EMBEDDING + [1.5,2.3,3.3], EMBEDDING - '[1,2,3]', [1,2,3] - EMBEDDING FROM ITEMS WHERE EMBEDDING > [0,0,0];
EMBEDDING + [1.5,2.3,3.3] | EMBEDDING - '[1,2,3]' | [1,2,3] - EMBEDDING
[2,4,6] | [0,0,0] | [0,0,0]
[2.5,4.3,6.3] | [0.5,0.3,0.3] | [-0.5,-0.3,-0.3]

VECTOR COMPARISON TESTS
SELECT * FROM ITEMS WHERE EMBEDDING > [0,0,0];
ID | EMBEDDING
1 | [1,2,3]
2 | [1.5,2.3,3.3]
SELECT * FROM ITEMS WHERE EMBEDDING = [1.5,2.3,3.3];
ID | EMBEDDING
1 | [1,2,3]

VECTOR OPERATION RESULT COMPARISON
SELECT * FROM ITEMS WHERE EMBEDDING + [1,1,1] > [2,3,4];
ID | EMBEDDING
2 | [1.5,2.3,3.3]
