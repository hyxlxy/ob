
CREATE TABLE Q1 (ID INT, AGE INT, NAME CHAR(10));
SUCCESS
CREATE TABLE Q2 (ID INT, AGE INT, NAME CHAR(10));
SUCCESS


INSERT INTO Q1 VALUES (1, 20, 'ALICEALICE');
SUCCESS
INSERT INTO Q1 VALUES (2, 25, 'BOBALICEAS');
SUCCESS
INSERT INTO Q1 VALUES (3, 30, 'CHARLIESAQ');
SUCCESS
INSERT INTO Q2 VALUES (1, 20, 'AAAAA');
SUCCESS
INSERT INTO Q2 VALUES (2, 25, 'BBBBB');
SUCCESS
INSERT INTO Q2 VALUES (3, 30, 'CCCCC');
SUCCESS



CREATE VIEW QQ1 AS SELECT ID, AGE, ID + AGE AS DATA FROM Q1;
SUCCESS

SELECT * FROM QQ1;
ID | AGE | DATA
1 | 20 | 21
2 | 25 | 27
3 | 30 | 33

SELECT * FROM QQ1 T1, Q1 T2;
ID | AGE | DATA | ID | AGE | NAME
1 | 20 | 21 | 1 | 20 | ALICEALICE
1 | 20 | 21 | 1 | 20 | BOBALICEAS
1 | 20 | 21 | 1 | 20 | CHARLIESAQ
2 | 25 | 27 | 2 | 25 | ALICEALICE
2 | 25 | 27 | 2 | 25 | BOBALICEAS
2 | 25 | 27 | 2 | 25 | CHARLIESAQ
3 | 30 | 33 | 3 | 30 | ALICEALICE
3 | 30 | 33 | 3 | 30 | BOBALICEAS
3 | 30 | 33 | 3 | 30 | CHARLIESAQ

SELECT * FROM QQ1 T1, Q1 T2 WHERE T1.ID = T2.ID;
ID | AGE | DATA | ID | AGE | NAME
1 | 20 | 21 | 1 | 20 | ALICEALICE
1 | 20 | 21 | 1 | 20 | BOBALICEAS
1 | 20 | 21 | 1 | 20 | CHARLIESAQ
2 | 25 | 27 | 2 | 25 | ALICEALICE
2 | 25 | 27 | 2 | 25 | BOBALICEAS
2 | 25 | 27 | 2 | 25 | CHARLIESAQ
3 | 30 | 33 | 3 | 30 | ALICEALICE
3 | 30 | 33 | 3 | 30 | BOBALICEAS
3 | 30 | 33 | 3 | 30 | CHARLIESAQ

CREATE VIEW QQ2 AS SELECT T2.NAME, T1.DATA FROM QQ1 T1, Q1 T2 WHERE T1.ID = T2.ID;
SUCCESS

SELECT * FROM QQ2;
NAME | DATA
ALICEALICE | 21
BOBALICEAS | 21
CHARLIESAQ | 21
ALICEALICE | 27
BOBALICEAS | 27
CHARLIESAQ | 27
ALICEALICE | 33
BOBALICEAS | 33
CHARLIESAQ | 33




