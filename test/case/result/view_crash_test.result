TEST VIEW FUNCTIONALITY FOR CRASHES
CREATE TABLE VIEW_TEST_TABLE(ID INT, NAME CHAR(10), SCORE INT);
SUCCESS

INSERT TEST DATA
INSERT INTO VIEW_TEST_TABLE VALUES (1, 'ALICE', 85);
SUCCESS
INSERT INTO VIEW_TEST_TABLE VALUES (2, 'BOB', 90);
SUCCESS
INSERT INTO VIEW_TEST_TABLE VALUES (3, 'CHARLIE', 75);
SUCCESS

TEST CREATE VIEW
CREATE VIEW HIGH_SCORE_VIEW AS SELECT ID, NAME FROM VIEW_TEST_TABLE WHERE SCORE > 80;
SUCCESS

TEST SELECT FROM VIEW (THIS MIGHT CRASH)
SELECT * FROM HIGH_SCORE_VIEW;
FAILURE

TEST DROP VIEW
DROP VIEW HIGH_SCORE_VIEW;
SUCCESS

CLEAN UP
DROP TABLE VIEW_TEST_TABLE;
SUCCESS
