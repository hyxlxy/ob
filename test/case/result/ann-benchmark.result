ANN BENCHMARK TESTS
CREATE TABLE ANN_TEST(ID INT, EMBEDDING VECTOR(3));
SUCCESS
INSERT INTO ANN_TEST VALUES(1, '[1.0, 2.0, 3.0]');
SUCCESS
INSERT INTO ANN_TEST VALUES(2, '[2.0, 3.0, 4.0]');
SUCCESS
INSERT INTO ANN_TEST VALUES(3, '[3.0, 4.0, 5.0]');
SUCCESS
INSERT INTO ANN_TEST VALUES(4, '[4.0, 5.0, 6.0]');
SUCCESS
INSERT INTO ANN_TEST VALUES(5, '[5.0, 6.0, 7.0]');
SUCCESS
CREATE INDEX ANN_IDX ON ANN_TEST USING IVFFLAT(EMBEDDING) WITH (LISTS=2);
SUCCESS
SELECT * FROM ANN_TEST ORDER BY L2_DISTANCE(EMBEDDING, '[1.5, 2.5, 3.5]') LIMIT 3;
ID | EMBEDDING
1 | [1, 2, 3]
2 | [2, 3, 4]
3 | [3, 4, 5]
SELECT * FROM ANN_TEST ORDER BY COSINE_DISTANCE(EMBEDDING, '[2.0, 3.0, 4.0]') LIMIT 2;
ID | EMBEDDING
2 | [2, 3, 4]
1 | [1, 2, 3]
SELECT * FROM ANN_TEST ORDER BY INNER_PRODUCT(EMBEDDING, '[1.0, 1.0, 1.0]') DESC LIMIT 3;
ID | EMBEDDING
5 | [5, 6, 7]
4 | [4, 5, 6]
3 | [3, 4, 5]
DROP TABLE ANN_TEST;
SUCCESS
