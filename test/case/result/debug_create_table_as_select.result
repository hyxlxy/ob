DEBUG CREATE TABLE AS SELECT
CREATE TABLE DEBUG_SOURCE(ID INT, NAME CHAR(5));
SUCCESS

INSERT DATA
INSERT INTO DEBUG_SOURCE VALUES (1, 'TEST');
SUCCESS

TEST SIMPLE CREATE TABLE AS SELECT
CREATE TABLE DEBUG_TARGET AS SELECT ID FROM DEBUG_SOURCE;
SUCCESS

CHECK IF TABLE WAS CREATED
SELECT * FROM DEBUG_TARGET;
COL1
1

CLEAN UP
DROP TABLE DEBUG_TARGET;
SUCCESS
DROP TABLE DEBUG_SOURCE;
SUCCESS
