TEST SYNTAX ERROR FOR AGGREGATION FUNCTIONS
CREATE TABLE AGGREGATION_FUNC(ID INT, NUM INT, PRICE FLOAT, ADDR CHAR(4), BIRTHDAY DATE);
SUCCESS

TEST INVALID COUNT SYNTAX - SHOULD RETURN SQL_SYNTAX ERROR
SELECT COUNT(*,NUM) FROM AGGREGATION_FUNC;
SQL_SYNTAX > FAILED TO PARSE SQL

TEST INVALID SUM SYNTAX - SHOULD RETURN SQL_SYNTAX ERROR
SELECT SUM(NUM,PRICE) FROM AGGREGATION_FUNC;
SQL_SYNTAX > FAILED TO PARSE SQL

TEST INVALID AVG SYNTAX - SHOULD RETURN SQL_SYNTAX ERROR
SELECT AVG(NUM,PRICE) FROM AGGREGATION_FUNC;
SQL_SYNTAX > FAILED TO PARSE SQL

TEST INVALID MIN SYNTAX - SHOULD RETURN SQL_SYNTAX ERROR
SELECT MIN(NUM,PRICE) FROM AGGREGATION_FUNC;
SQL_SYNTAX > FAILED TO PARSE SQL

TEST INVALID MAX SYNTAX - SHOULD RETURN SQL_SYNTAX ERROR
SELECT MAX(NUM,PRICE) FROM AGGREGATION_FUNC;
SQL_SYNTAX > FAILED TO PARSE SQL

CLEAN UP
DROP TABLE AGGREGATION_FUNC;
SUCCESS
