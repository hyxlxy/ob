COUNT NULL SIMPLE TEST

CREATE TABLE TEST_COUNT(ID INT NOT NULL, NAME CHAR(10) NULL);
SUCCESS

INSERT INTO TEST_COUNT VALUES(1, 'ALICE');
SUCCESS
INSERT INTO TEST_COUNT VALUES(2, NULL);
SUCCESS
INSERT INTO TEST_COUNT VALUES(3, 'BOB');
SUCCESS

SELECT COUNT(*) FROM TEST_COUNT;
COUNT(*)
3
SELECT COUNT(NAME) FROM TEST_COUNT;
COUNT(NAME)
2

DROP TABLE TEST_COUNT;
SUCCESS
