JOIN MULTI-CONDITION FIX TEST
CREATE TABLE USERS(ID INT, NAME CHAR(20), DEPT_ID INT);
SUCCESS
CREATE TABLE DEPARTMENTS(ID INT, NAME CHAR(20), LOCATION CHAR(20));
SUCCESS
INSERT INTO USERS VALUES(1, 'ALICE', 10);
SUCCESS
INSERT INTO USERS VALUES(2, 'BOB', 20);
SUCCESS
INSERT INTO USERS VALUES(3, 'CHARLIE', 10);
SUCCESS
INSERT INTO DEPARTMENTS VALUES(10, 'ENGINEERING', 'BUILDING A');
SUCCESS
INSERT INTO DEPARTMENTS VALUES(20, 'MARKETING', 'BUILDING B');
SUCCESS
INSERT INTO DEPARTMENTS VALUES(30, 'SALES', 'BUILDING C');
SUCCESS
SELECT * FROM USERS INNER JOIN DEPARTMENTS ON USERS.DEPT_ID = DEPARTMENTS.ID;
USERS.ID | USERS.NAME | USERS.DEPT_ID | DEPARTMENTS.ID | DEPARTMENTS.NAME | DEPARTMENTS.LOCATION
1 | ALICE | 10 | 10 | ENGINEERING | BUILDING A
2 | BOB | 20 | 20 | MARKETING | BUILDING B
3 | CHARLIE | 10 | 10 | ENGINEERING | BUILDING A
SELECT * FROM USERS INNER JOIN DEPARTMENTS ON USERS.DEPT_ID = DEPARTMENTS.ID AND DEPARTMENTS.ID > 15;
USERS.ID | USERS.NAME | USERS.DEPT_ID | DEPARTMENTS.ID | DEPARTMENTS.NAME | DEPARTMENTS.LOCATION
2 | BOB | 20 | 20 | MARKETING | BUILDING B
DROP TABLE USERS;
SUCCESS
