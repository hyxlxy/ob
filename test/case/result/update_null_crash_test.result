TEST UPDATE NULL VALUE CRASH
CREATE TABLE NULL_TABLE4(ID INT NOT NULL, NUM INT NULL, NAME CHAR(10) NULL);
SUCCESS

INSERT TEST DATA
INSERT INTO NULL_TABLE4 VALUES (7, 7, 'N7');
SUCCESS
INSERT INTO NULL_TABLE4 VALUES (6, 6, 'N6');
SUCCESS
INSERT INTO NULL_TABLE4 VALUES (3, 3, 'N3');
SUCCESS
INSERT INTO NULL_TABLE4 VALUES (1, NULL, 'N1');
SUCCESS

TEST UPDATE WITH NULL CONDITION THAT CAUSES CRASH
UPDATE NULL_TABLE4 SET NAME=NULL WHERE NUM=NULL;
SUCCESS

CLEAN UP
DROP TABLE NULL_TABLE4;
SUCCESS
