
CREATE TABLE Q1 (ID INT, AGE INT, NAME CHAR(10));
SUCCESS
CREATE TABLE Q2 (ID INT, AGE INT, NAME CHAR(10));
SUCCESS


INSERT INTO Q1 VALUES (1, 20, 'ALICEALICE');
SUCCESS
INSERT INTO Q1 VALUES (2, 25, 'BOBALICEAS');
SUCCESS
INSERT INTO Q1 VALUES (3, 30, 'CHARLIESAQ');
SUCCESS
INSERT INTO Q2 VALUES (1, 20, 'AAAAA');
SUCCESS
INSERT INTO Q2 VALUES (2, 25, 'BBBBB');
SUCCESS
INSERT INTO Q2 VALUES (3, 30, 'CCCCC');
SUCCESS



CREATE VIEW QQ1 AS SELECT T1.ID AS ID, T1.AGE AS AGE, T2.NAME AS NAME FROM Q1 T1, Q2 T2 WHERE T1.ID = T2.ID;
SUCCESS

SELECT * FROM QQ1;
ID | AGE | NAME
1 | 20 | AAAAA
2 | 25 | BBBBB
3 | 30 | CCCCC

SELECT COUNT(*) FROM QQ1;
COUNT(*)
3


INSERT INTO QQ1(ID, AGE) VALUES(999,999);
SUCCESS

SELECT * FROM Q1;
ID | AGE | NAME
1 | 20 | ALICEALICE
2 | 25 | BOBALICEAS
3 | 30 | CHARLIESAQ
999 | 999 | NULL

SELECT * FROM QQ1;
ID | AGE | NAME
1 | 20 | AAAAA
2 | 25 | BBBBB
3 | 30 | CCCCC

INSERT INTO QQ1 VALUES(100,100,'AAA');
FAILURE

DELETE FROM QQ1 WHERE ID = 1;
FAILURE

SELECT * FROM QQ1;
ID | AGE | NAME
1 | 20 | AAAAA
2 | 25 | BBBBB
3 | 30 | CCCCC

CREATE VIEW QQ2 AS SELECT T1.ID AS ID, T1.AGE AS AGE, T1.NAME AS NAME FROM Q1 T1;
SUCCESS

SELECT * FROM QQ2;
ID | AGE | NAME
1 | 20 | ALICEALICE
2 | 25 | BOBALICEAS
3 | 30 | CHARLIESAQ
999 | 999 | NULL

SELECT COUNT(*) FROM QQ2;
COUNT(*)
4

INSERT INTO QQ2 VALUES(99,99,'AACC');
SUCCESS

SELECT * FROM QQ2;
ID | AGE | NAME
1 | 20 | ALICEALICE
2 | 25 | BOBALICEAS
3 | 30 | CHARLIESAQ
999 | 999 | NULL
99 | 99 | AACC

DELETE FROM QQ2 WHERE ID = 1;
SUCCESS

SELECT * FROM QQ2;
ID | AGE | NAME
2 | 25 | BOBALICEAS
3 | 30 | CHARLIESAQ
999 | 999 | NULL
99 | 99 | AACC

CREATE VIEW QQ3 AS SELECT ID, AGE, ID + AGE AS DATA FROM Q1;
SUCCESS

SELECT * FROM QQ3;
ID | AGE | DATA
2 | 25 | 27
3 | 30 | 33
999 | 999 | 1998
99 | 99 | 198

SELECT SUM(AGE) FROM QQ3;
SUM(AGE)
1153

DELETE FROM QQ3 WHERE ID = 1;
SUCCESS

SELECT SUM(AGE) FROM QQ3;
SUM(AGE)
1153

SELECT SUM(T1.AGE) FROM Q1 T1,Q1 T2;
SUM(T1.AGE)
4612


