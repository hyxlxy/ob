TEST TEXT TYPE SUPPORT
CREATE TABLE TEXT_TEST(ID INT, CONTENT CHAR(50), TEXT_CONTENT TEXT);
SUCCESS

INSERT TEXT DATA
INSERT INTO TEXT_TEST VALUES (1, 'CHARA', 'TEXTA');
SUCCESS
INSERT INTO TEXT_TEST VALUES (2, 'CHARHELLO', 'TEXTHELLO');
SUCCESS

QUERY TEXT DATA
SELECT * FROM TEXT_TEST;
ID | CONTENT | TEXT_CONTENT
1 | CHARA | 
2 | CHARHELLO |

CLEAN UP
DROP TABLE TEXT_TEST;
SUCCESS
