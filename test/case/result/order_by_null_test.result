TEST ORDER BY WITH NULL VALUES
CREATE TABLE ORDER_TEST(ID INT, NAME CHAR(10), SCORE INT);
SUCCESS

INSERT TEST DATA WITH NULL VALUES
INSERT INTO ORDER_TEST VALUES (1, 'ALICE', 85);
SUCCESS
INSERT INTO ORDER_TEST VALUES (2, 'BOB', NULL);
FAILURE
INSERT INTO ORDER_TEST VALUES (3, NULL, 90);
FAILURE
INSERT INTO ORDER_TEST VALUES (4, 'CHARLIE', NULL);
FAILURE

TEST ORDER BY WITH NULL VALUES (MIGHT CRASH)
SELECT * FROM ORDER_TEST ORDER BY SCORE;
ID | NAME | SCORE
1 | ALICE | 85

TEST ORDER BY DESC WITH NULL VALUES
SELECT * FROM ORDER_TEST ORDER BY SCORE DESC;
ID | NAME | SCORE
1 | ALICE | 85

TEST ORDER BY WITH NULL NAME VALUES
SELECT * FROM ORDER_TEST ORDER BY NAME;
ID | NAME | SCORE
1 | ALICE | 85

CLEAN UP
DROP TABLE ORDER_TEST;
SUCCESS
