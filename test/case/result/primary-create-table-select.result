CREATE TABLE SELECT TESTS
CREATE TABLE CREATE_TABLE_SELECT_T1(ID INT, NAME CHAR(20), AGE INT);
SUCCESS
CREATE TABLE CREATE_TABLE_SELECT_T2(ID INT, SCORE FLOAT);
SUCCESS
INSERT INTO CREATE_TABLE_SELECT_T1 VALUES(1, 'ALICE', 20);
SUCCESS
INSERT INTO CREATE_TABLE_SELECT_T1 VALUES(2, 'BOB', 21);
SUCCESS
INSERT INTO CREATE_TABLE_SELECT_T1 VALUES(3, 'CHARLIE', 22);
SUCCESS
INSERT INTO CREATE_TABLE_SELECT_T2 VALUES(1, 85.5);
SUCCESS
INSERT INTO CREATE_TABLE_SELECT_T2 VALUES(2, 78.0);
SUCCESS
INSERT INTO CREATE_TABLE_SELECT_T2 VALUES(3, 92.5);
SUCCESS
CREATE TABLE CREATE_TABLE_SELECT_T3 AS SELECT T1.ID, T1.NAME, T2.SCORE FROM CREATE_TABLE_SELECT_T1 T1, CREATE_TABLE_SELECT_T2 T2 WHERE T1.ID = T2.ID;
SUCCESS
SELECT * FROM CREATE_TABLE_SELECT_T3;
ID | NAME | SCORE
1 | ALICE | 85.5
2 | BOB | 78
3 | CHARLIE | 92.5
CREATE TABLE CREATE_TABLE_SELECT_T4 AS SELECT ID, NAME FROM CREATE_TABLE_SELECT_T1 WHERE AGE > 20;
SUCCESS
SELECT * FROM CREATE_TABLE_SELECT_T4;
ID | NAME
2 | BOB
3 | CHARLIE
