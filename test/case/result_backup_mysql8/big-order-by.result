BIG ORDER BY TESTS
CREATE TABLE BIG_ORDER_T1(ID INT, COL1 INT, COL2 FLOAT);
SUCCESS
CREATE TABLE BIG_ORDER_T2(ID INT, COL3 CHAR(10), COL4 INT);
SUCCESS
CREATE TABLE BIG_ORDER_T3(ID INT, COL5 FLOAT, COL6 INT);
SUCCESS
