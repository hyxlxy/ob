SELECT T1.ID, T1.COL1, T1.COL2, T2.COL3, T2.COL4, T3.COL5, T3.COL6 FROM BIG_ORDER_T1 T1, BIG_ORDER_T2 T2, BIG_ORDER_T3 T3 WHERE T1.ID = T2.ID AND T2.ID = T3.ID ORDER BY T1.COL1, T2.COL4, T3.COL6;
