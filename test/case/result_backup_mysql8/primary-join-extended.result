SELECT JOIN_TEST1.NAME, JOIN_TEST2.DEPT_NAME FROM JOIN_TEST1 INNER JOIN JOIN_TEST2 ON JOIN_TEST1.DEPT_ID = JOIN_TEST2.ID WHERE JOIN_TEST2.LOCATION = 'BUILDING A';
