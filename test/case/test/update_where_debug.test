DROP TABLE IF EXISTS update_test;
CREATE TABLE update_test(id int, name char(10), col1 int, col2 int);
INSERT INTO update_test VALUES (1, 'A', 3, 4);
INSERT INTO update_test VALUES (1, 'B', 6, 7);
