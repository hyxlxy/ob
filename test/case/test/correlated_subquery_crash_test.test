CREATE TABLE csq_1(id int, feat1 int);
CREATE TABLE csq_2(id int, feat2 int);
INSERT INTO csq_1 VALUES (1, 5);
INSERT INTO csq_1 VALUES (2, 7);
INSERT INTO csq_1 VALUES (3, 3);
INSERT INTO csq_2 VALUES (1, 6);
INSERT INTO csq_2 VALUES (2, 8);
INSERT INTO csq_2 VALUES (3, 4);
SELECT * FROM csq_1 WHERE feat1 <> (SELECT MIN(csq_2.feat2) FROM csq_2 WHERE csq_2.feat2 > csq_1.feat1);
DROP TABLE csq_1;
DROP TABLE csq_2;
