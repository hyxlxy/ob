-- echo Test CREATE TABLE AS SELECT syntax
CREATE TABLE source_table(id int, name char(10), score int);

-- echo Insert test data
INSERT INTO source_table VALUES (1, 'Alice', 85);
INSERT INTO source_table VALUES (2, 'Bob', 90);

-- echo Test CREATE TABLE AS SELECT (should succeed now)
CREATE TABLE target_table AS SELECT id, name FROM source_table WHERE score > 80;

-- echo Verify the created table
SELECT * FROM target_table;

-- echo Clean up
DROP TABLE target_table;
DROP TABLE source_table;
