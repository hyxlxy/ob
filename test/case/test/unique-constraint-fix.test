-- echo Unique Constraint Fix Test

create table unique_test(id int, email char(50));

create unique index idx_email on unique_test(email);

insert into unique_test values(1, 'alice@test.com');
insert into unique_test values(2, 'bob@test.com');

select * from unique_test;

insert into unique_test values(3, 'alice@test.com');

select * from unique_test;

drop table unique_test;
