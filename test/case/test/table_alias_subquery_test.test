CREATE TABLE table_alias_1(id int, col1 int);
CREATE TABLE table_alias_2(id int, col2 int);
INSERT INTO table_alias_1 VALUES (1, 10);
INSERT INTO table_alias_1 VALUES (2, 20);
INSERT INTO table_alias_1 VALUES (3, 30);
INSERT INTO table_alias_2 VALUES (1, 15);
INSERT INTO table_alias_2 VALUES (2, 25);
INSERT INTO table_alias_2 VALUES (3, 35);
SELECT * FROM table_alias_1 t1 WHERE id IN (SELECT t2.id FROM table_alias_2 t2 WHERE t2.col2 >= t1.col1);
DROP TABLE table_alias_1;
DROP TABLE table_alias_2;
