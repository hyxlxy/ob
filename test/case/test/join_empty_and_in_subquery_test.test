
DROP TABLE IF EXISTS join_table_empty_1;
DROP TABLE IF EXISTS join_table_1;
CREATE TABLE join_table_empty_1(id int, num_empty_1 int);
CREATE TABLE join_table_1(id int, name char(20));
INSERT INTO join_table_1 VALUES (1, 'Alice');
INSERT INTO join_table_1 VALUES (2, 'Bob');
INSERT INTO join_table_1 VALUES (3, 'Charlie');
SELECT * FROM join_table_empty_1 INNER JOIN join_table_1 ON join_table_empty_1.id=join_table_1.id;
DROP TABLE join_table_empty_1;
DROP TABLE join_table_1;

DROP TABLE IF EXISTS ssq_1;
DROP TABLE IF EXISTS ssq_2;
CREATE TABLE ssq_1(id int, col1 int, feat1 float);
CREATE TABLE ssq_2(id int, col2 int, feat2 float);
INSERT INTO ssq_1 VALUES (46, 97, 31.67);
INSERT INTO ssq_1 VALUES (7, 72, 71.87);
INSERT INTO ssq_1 VALUES (8, 15, 51.23);
INSERT INTO ssq_2 VALUES (1, 72, 10.5);
INSERT INTO ssq_2 VALUES (2, 99, 20.3);
INSERT INTO ssq_2 VALUES (3, 15, 30.1);
SELECT * FROM ssq_1 WHERE col1 IN (SELECT ssq_2.col2 FROM ssq_2);
DROP TABLE ssq_1;
DROP TABLE ssq_2;
