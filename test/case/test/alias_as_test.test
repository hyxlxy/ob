DROP TABLE IF EXISTS t1;
DROP TABLE IF EXISTS t2;
CREATE TABLE t1(id int, col1 int, feat1 float);
CREATE TABLE t2(id int, col2 int, feat2 float);
INSERT INTO t1 VALUES (1, 10, 1.1);
INSERT INTO t1 VALUES (3, 30, 3.3);
INSERT INTO t2 VALUES (2, 20, 2.2);
INSERT INTO t2 VALUES (4, 40, 4.4);
SELECT t1.id as num, t1.col1 as age, t1.feat1, t2.* FROM t1, t2 WHERE t1.id < t2.id;
DROP TABLE t1;
DROP TABLE t2;
