-- echo Test CREATE TABLE AS SELECT and COUNT
CREATE TABLE create_table_select_t1(id int, age int, name char(10));
INSERT INTO create_table_select_t1 VALUES (1, 20, 'Alice');
INSERT INTO create_table_select_t1 VALUES (2, 21, 'Bob');
INSERT INTO create_table_select_t1 VALUES (3, 22, 'Charlie');

CREATE TABLE create_table_select_t2 AS SELECT * FROM create_table_select_t1;
SELECT count(*) FROM create_table_select_t2;

-- echo Test CREATE VIEW and COUNT
CREATE VIEW create_view_v1 AS SELECT * FROM create_table_select_t1;
SELECT count(*) FROM create_view_v1;

-- echo Clean up
DROP VIEW create_view_v1;
