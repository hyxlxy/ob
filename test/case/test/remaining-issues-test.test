-- echo REMAINING ISSUES TEST

create table Select_meta(id int, name char(10));
insert into Select_meta values(1, 'test');
select no_column from Select_meta;
select * from Select_meta where no_column='001';

create table exp_table(id int, col1 int, col2 int, col3 float, col4 float);
insert into exp_table values(3, 10, 5, 6.12, 400);
select id,-(col2*(-1)+3)+(col4+7)*(col1+col3*5),(1+col2)*col3*1 from exp_table where -(col2*(-2)+2)+(col4+9)*(col1+col3*5) > (7+col2)*col3*1;

create table unique_table2(id1 int, id2 int, col1 int, col2 int);
insert into unique_table2 values (1,1,1,1);
create unique index index_id on unique_table2(id1);
insert into unique_table2 values (2,3,1,1);
insert into unique_table2 values (1,4,2,2);

drop table Select_meta;
drop table exp_table;
drop table unique_table2;
