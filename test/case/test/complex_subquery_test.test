-- echo Test complex subquery that might crash
CREATE TABLE table_alias_1(id int, col1 int, feat1 float);
CREATE TABLE table_alias_2(id int, col2 int, feat2 float);

-- echo Insert test data
INSERT INTO table_alias_1 VALUES (52, 52, 36.4);
INSERT INTO table_alias_1 VALUES (67, 50, 60.2);
INSERT INTO table_alias_2 VALUES (52, 55, 40.1);
INSERT INTO table_alias_2 VALUES (67, 45, 55.3);

-- echo Test correlated subquery that might cause crash
SELECT * FROM table_alias_1 t1 WHERE id IN (SELECT t2.id FROM table_alias_2 t2 WHERE t2.col2 >= t1.col1);

-- echo Clean up
DROP TABLE table_alias_1;
DROP TABLE table_alias_2;
