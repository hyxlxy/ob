--echo 子查询修复测试文件
--echo 测试两个有问题的查询

--echo 清理可能存在的表
DROP TABLE IF EXISTS csq_1, csq_2, csq_3, ssq_1, ssq_2;

--echo 创建测试表 csq_1, csq_2, csq_3
CREATE TABLE csq_1(id int, col1 int, feat1 float);
INSERT INTO csq_1 VALUES (1, 4, 11.2);
INSERT INTO csq_1 VALUES (2, 2, 12.0);
INSERT INTO csq_1 VALUES (3, 3, 13.5);
INSERT INTO csq_1 VALUES (55, 41, 79.73);

CREATE TABLE csq_2(id int, col2 int, feat2 float);
INSERT INTO csq_2 VALUES (1, 2, 13.0);
INSERT INTO csq_2 VALUES (2, 7, 10.5);
INSERT INTO csq_2 VALUES (5, 3, 12.6);

CREATE TABLE csq_3(id int, col3 int, feat3 float);
INSERT INTO csq_3 VALUES (1, 2, 11.0);
INSERT INTO csq_3 VALUES (3, 6, 16.5);
INSERT INTO csq_3 VALUES (5, 5, 14.6);


CREATE TABLE ssq_1(id int, name varchar(20));
INSERT INTO ssq_1 VALUES (1, 'Alice');
INSERT INTO ssq_1 VALUES (2, 'Bob');
INSERT INTO ssq_1 VALUES (3, 'Charlie');

CREATE TABLE ssq_2(id int, name varchar(20));
INSERT INTO ssq_2 VALUES (1, 'Alice');
INSERT INTO ssq_2 VALUES (2, 'Bob');


SELECT * FROM csq_1 WHERE col1 > (SELECT MAX(csq_2.col2) FROM csq_2 WHERE csq_2.feat2 >= (SELECT MIN(csq_3.feat3) FROM csq_3));


SELECT * FROM ssq_1 WHERE id IN (SELECT ssq_2.id FROM ssq_2);


SELECT MIN(csq_3.feat3) FROM csq_3;


SELECT MAX(csq_2.col2) FROM csq_2 WHERE csq_2.feat2 >= 11.0;


SELECT * FROM csq_1 WHERE col1 > 3;


SELECT * FROM ssq_1 WHERE id IN (1, 2);


DROP TABLE csq_1;
DROP TABLE csq_2;
DROP TABLE csq_3;
DROP TABLE ssq_1;
DROP TABLE ssq_2;
