CREATE TABLE t_group_by (id int not null, score int not null, name char(1) null);
insert into t_group_by VALUES (1, 1, 'O');
insert into t_group_by VALUES (1, 3, 'P');
insert into t_group_by VALUES (6, 4, 'Q');
insert into t_group_by VALUES (6, 5, 'R');
insert into t_group_by VALUES (9, 2, 'S');
insert into t_group_by VALUES (9, 3, 'T');
select id, max(score) from t_group_by group by id having count(*)>1 and max(score)>3;