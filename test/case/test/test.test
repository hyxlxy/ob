
create table exp_table(id int, col1 int, col2 int, col3 float, col4 float);
create table exp_table2(id int, col1 int);
insert into exp_table VALUES (3, 1, 4, 8.08, 4.08);
insert into exp_table VALUES (9, 7, 6, 5.21, 2.03);
insert into exp_table VALUES (2, 9, 8, 8.01, 6.5);
select exp_table.id,3*exp_table2.col1/(exp_table.col2+6) from exp_table,exp_table2 where exp_table2.col1/(5-exp_table.col2)*3>2;
