
DROP TABLE IF EXISTS csq_1, csq_2;


CREATE TABLE csq_1(id int, feat1 float);
INSERT INTO csq_1 VALUES (1, 10.0);
INSERT INTO csq_1 VALUES (2, 20.0);
INSERT INTO csq_1 VALUES (3, 30.0);

CREATE TABLE csq_2(id int, feat2 float);
INSERT INTO csq_2 VALUES (1, 5.0);
INSERT INTO csq_2 VALUES (2, 15.0);
INSERT INTO csq_2 VALUES (3, 25.0);


SELECT * FROM csq_1 WHERE feat1 > (SELECT MIN(csq_2.feat2) FROM csq_2 WHERE csq_2.feat2 > csq_1.feat1);


SELECT * FROM csq_1 WHERE feat1 <> (SELECT MIN(csq_2.feat2) FROM csq_2 WHERE csq_2.feat2 > csq_1.feat1);


SELECT * FROM csq_1 WHERE feat1 > (SELECT MIN(feat2) FROM csq_2);


SELECT * FROM csq_1 WHERE id IN (SELECT id FROM csq_2 WHERE feat2 > 10);


DROP TABLE csq_1;
DROP TABLE csq_2;