
CREATE TABLE TEST (ID INT, C1 VECTOR(3));
INSERT INTO TEST VALUES(1, STRING_TO_VECTOR('[9.44,-4.4,3.53]'));
INSERT INTO TEST VALUES(2, STRING_TO_VECTOR('[-4.23,-6.73,-4.69]'));
INSERT INTO TEST VALUES(3, STRING_TO_VECTOR('[-7.98,5.93,5.45]'));
INSERT INTO TEST VALUES(4, STRING_TO_VECTOR('[-0.87,-2.89,9.11]'));
INSERT INTO TEST VALUES(5, STRING_TO_VECTOR('[3.91,0.76,3.2]'));
SELECT DISTANCE(STRING_TO_VECTOR('[3.37,4.33,4.1,6.51,-0.48]'), STRING_TO_VECTOR('[-9.86,2.45,-1.78,3.23,-4.62]'), 'COSINE') AS DIST_COSINE;
SELECT DISTANCE(STRING_TO_VECTOR('[5.32,5.9,-0.49,4.24,-2.04]'), STRING_TO_VECTOR('[-3.68,8.96,4.45,-2.32,-7.39]'), 'EUCLIDEAN') AS DIST_EUC;
SELECT DISTANCE(STRING_TO_VECTOR('[1.81,0.83,6.36,2.51,0.89]'), STRING_TO_VECTOR('[6.69,2.07,-7.88,5.41,-1.67]'), 'DOT') AS DIST_DOT;
SELECT DISTANCE(STRING_TO_VECTOR('[-9.73,6.95,-4.19,-9.69]'), STRING_TO_VECTOR('[-4.23,-1.51,-9.89,-8.3,5.87]'), 'DOT') AS DIST_DOT;
CREATE TABLE TAB_VEC(ID INT, A INT, B VECTOR(10));
INSERT INTO TAB_VEC VALUES(1, 1, STRING_TO_VECTOR('[3.78,3.34,1.85,0.13,1.03,2.4,4.78,0.17,1.89,0.65]'));
INSERT INTO TAB_VEC VALUES(2, 2, STRING_TO_VECTOR('[3.53,2.02,1.7,4.01,0.0,2.96,2.36,0.9,3.59,4.09]'));
INSERT INTO TAB_VEC VALUES(3, 3, STRING_TO_VECTOR('[0.66,2.19,3.25,3.99,4.27,2.19,2.67,2.86,4.18,4.29]'));
INSERT INTO TAB_VEC VALUES(4, 4, STRING_TO_VECTOR('[0.54,0.76,3.36,0.36,4.51,4.08,1.83,1.3,1.28,0.5]'));
SELECT ID FROM TAB_VEC ORDER BY DISTANCE(B, STRING_TO_VECTOR('[0.19,4.54,0.18,4.56,2.66,4.63,0.83,3.67,3.42,4.58]'), 'EUCLIDEAN') LIMIT 50;