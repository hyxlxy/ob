DROP TABLE IF EXISTS csq_1, csq_2;

CREATE TABLE csq_1(id int, feat1 float, name varchar(20));
INSERT INTO csq_1 VALUES (1, 10.0, 'A');
INSERT INTO csq_1 VALUES (2, 20.0, 'B');
INSERT INTO csq_1 VALUES (3, 30.0, 'C');
INSERT INTO csq_1 VALUES (4, 15.0, 'D');
INSERT INTO csq_1 VALUES (5, 25.0, 'E');

CREATE TABLE csq_2(id int, feat2 float, category varchar(20));
INSERT INTO csq_2 VALUES (1, 5.0, 'X');
INSERT INTO csq_2 VALUES (2, 15.0, 'Y');
INSERT INTO csq_2 VALUES (3, 25.0, 'Z');
INSERT INTO csq_2 VALUES (4, 12.0, 'X');
INSERT INTO csq_2 VALUES (5, 18.0, 'Y');

SELECT * FROM csq_1 WHERE feat1 > (SELECT MIN(csq_2.feat2) FROM csq_2 WHERE csq_2.feat2 > csq_1.feat1);

SELECT * FROM csq_1 WHERE feat1 <> (SELECT MIN(csq_2.feat2) FROM csq_2 WHERE csq_2.feat2 > csq_1.feat1);

SELECT * FROM csq_1 WHERE id IN (SELECT id FROM csq_2 WHERE feat2 > csq_1.feat1);

SELECT * FROM csq_1 WHERE id NOT IN (SELECT id FROM csq_2 WHERE feat2 < csq_1.feat1);

SELECT * FROM csq_1 WHERE EXISTS (SELECT 1 FROM csq_2 WHERE csq_2.feat2 > csq_1.feat1);

SELECT * FROM csq_1 WHERE NOT EXISTS (SELECT 1 FROM csq_2 WHERE csq_2.feat2 < csq_1.feat1);

SELECT * FROM csq_1 WHERE feat1 > (SELECT AVG(feat2) FROM csq_2 WHERE feat2 > csq_1.feat1);

SELECT * FROM csq_1 WHERE feat1 = (SELECT feat2 FROM csq_2 WHERE feat2 > 10);

SELECT * FROM csq_1 WHERE feat1 = (SELECT feat2 FROM csq_2 WHERE feat2 > 100);

SELECT * FROM csq_1 WHERE feat1 = (SELECT feat2 FROM csq_2 WHERE feat2 > 100);

DROP TABLE csq_1;
DROP TABLE csq_2;