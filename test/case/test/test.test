
CREATE TABLE function_table(id int, name char(20), score float, u_date date);
CREATE TABLE function_table_2(id int, name char(30), score float, u_date date);
insert into function_table VALUES (1, '83D4', 5.84, '2024-10-15');
insert into function_table VALUES (7, 'GFYNUI84YECEAQ6ILA', 7.92, '2017-05-03');
insert into function_table VALUES (4, '5R148BAZ7UZAOWGOX', 9.31, '2024-06-30');
select length('') a1, length('abc') a2, length(name) a3 from function_table order by id;
select length(score) fail_len from function_table;
select round(score) r0 from function_table order by id;
select round(3.8155, 2) r_prec;
select round(score, 1) r1 from function_table order by id;
select round(name) fail_round from function_table;
select date_format(u_date, '%Y-%m-%d') f1, date_format(u_date, '%y-%m-%d') f2, date_format(u_date, '%D,%M,%Y') f3 from function_table order by id;
select date_format('2024-05-20', 'abc %z def %n ghi') passthrough;
select date_format(name, '%Y') fail_df1 from function_table;
select date_format(u_date, 123) fail_df2 from function_table;
