
create table exp_table(id int, col1 int, col2 int, col3 float, col4 float);
create table exp_table2(id int, col1 int);
insert into exp_table VALUES (2, 8, 1, 9.0, 6.23);
insert into exp_table VALUES (7, 4, 5, 1.6, 5.68);
insert into exp_table VALUES (4, 2, 8, 8.69, 5.12);
select id,-(col2*(-3)+9)+(col4+7)*(col1+col3*1),(6+col2)*col3*3 from exp_table where -(col2*(-1)+6)+(col4+3)*(col1+col3*5) > (1+col2)*col3*4;
