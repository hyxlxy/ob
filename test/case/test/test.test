CREATE TABLE TEST (ID INT, C1 VECTOR(3));

INSERT INTO TEST VALUES(1, STRING_TO_VECTOR('[-4.87,-9.62,3.46]'));
INSERT INTO TEST VALUES(2, STRING_TO_VECTOR('[-1.14,8.82,6.88]'));
INSERT INTO TEST VALUES(3, STRING_TO_VECTOR('[-0.72,-6.37,8.09]'));
INSERT INTO TEST VALUES(4, STRING_TO_VECTOR('[0.7,4.93,-9.03]'));
INSERT INTO TEST VALUES(5, STRING_TO_VECTOR('[-10.0,2.46,3.49]'));
SELECT ID, VECTOR_TO_STRING(C1) AS VEC_STR FROM TEST;

CREATE TABLE TAB_VEC(ID INT, A INT, B VECTOR(10));
INSERT INTO TAB_VEC VALUES(1, 1, STRING_TO_VECTOR('[2.43,0.85,2.8,0.98,0.25,1.24,3.77,4.62,0.3,1.5]'));
INSERT INTO TAB_VEC VALUES(2, 2, STRING_TO_VECTOR('[2.73,4.31,4.71,3.93,2.86,4.72,4.77,2.74,2.45,3.88]'));
INSERT INTO TAB_VEC VALUES(3, 3, STRING_TO_VECTOR('[2.83,2.96,4.66,1.85,0.76,3.14,0.08,1.24,0.76,4.05]'));
INSERT INTO TAB_VEC VALUES(4, 4, STRING_TO_VECTOR('[0.09,4.47,1.21,4.31,2.55,1.73,0.53,2.87,0.5,1.53]'));
SELECT ID FROM TAB_VEC ORDER BY DISTANCE(B, STRING_TO_VECTOR('[0.95,0.12,2.44,4.02,1.16,0.88,4.26,3.56,1.16,1.41]'), 'EUCLIDEAN') LIMIT 1;
