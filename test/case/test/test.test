CREATE TABLE t(id INT, name CHAR(20), v INT)
CREATE TABLE t1(id INT, name1 CHAR(20), v1 INT)
CREATE TABLE t2(id INT, v2 INT)
CREATE TABLE t3(id INT, v3 INT)
INSERT INTO t VALUES (1,'A',10)
INSERT INTO t VALUES (2,'B',20)
INSERT INTO t VALUES (3,'C',30)
INSERT INTO t VALUES (4,'D',40)
INSERT INTO t1 VALUES (1,'A1',10)
INSERT INTO t1 VALUES (2,'B1',25)
INSERT INTO t1 VALUES (3,'C1',30)
INSERT INTO t1 VALUES (5,'E1',50)
INSERT INTO t2 VALUES (1,100)
INSERT INTO t2 VALUES (2,200)
INSERT INTO t2 VALUES (3,300)
INSERT INTO t2 VALUES (2,201)
INSERT INTO t2 VALUES (4,400)
INSERT INTO t3 VALUES (1,1000)
INSERT INTO t3 VALUES (3,3000)
INSERT INTO t3 VALUES (4,4000)
SELECT * FROM t INNER JOIN t1 ON t.id=t1.id
SELECT t.id,t.name,t1.name1 FROM t INNER JOIN t1 ON t.id=t1.id AND t.v=t1.v1
SELECT t.id,t.name,t1.name1,t2.v2 FROM t INNER JOIN t1 ON t.id=t1.id INNER JOIN t2 ON t.id=t2.id
SELECT * FROM t INNER JOIN t1 ON t.id=t1.id, t2 WHERE t2.id=t.id
SELECT t.id,t1.name1,t2.v2 FROM t INNER JOIN t1 ON t.id=t1.id, t2 WHERE t2.id=t1.id AND t2.v2>150
SELECT t.id,t.v,t1.v1,t2.v2 FROM t INNER JOIN t1 ON t.id=t1.id AND t.v=t1.v1 INNER JOIN t2 ON t.id=t2.id AND t2.v2>=200
SELECT t.id,t1.name1,t2.v2,t3.v3 FROM t INNER JOIN t1 ON t.id=t1.id INNER JOIN t2 ON t.id=t2.id INNER JOIN t3 ON t.id=t3.id
SELECT * FROM t INNER JOIN t1 ON t.id=t1.id AND t.v=999
SELECT a.id,b.name1,c.v2 FROM t a INNER JOIN t1 b ON a.id=b.id INNER JOIN t2 c ON a.id=c.id WHERE c.v2<250
SELECT t.id, t2.v2/(t.v/10) AS ratio FROM t INNER JOIN t2 ON t.id=t2.id WHERE t2.v2/(t.v/10) > 10
SELECT t.id,t3.v3 FROM t INNER JOIN t1 ON t.id=t1.id, t3 WHERE t3.id=t.id AND t.id IN (1,3)
SELECT t.id,t1.id FROM t INNER JOIN t1 ON t.id=t1.id AND t.v >= t1.v1
