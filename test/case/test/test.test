

CREATE TABLE VEC_TEST(ID INT, V VECTOR(2));


INSERT INTO VEC_TEST VALUES(10, STRING_TO_VECTOR('[1.0, 0.0]'));
INSERT INTO VEC_TEST VALUES(20, STRING_TO_VECTOR('[2.0, 0.0]'));
INSERT INTO VEC_TEST VALUES(30, STRING_TO_VECTOR('[3.0, 0.0]'));

SELECT ID FROM VEC_TEST ORDER BY DISTANCE(V, STRING_TO_VECTOR('[0.0, 0.0]'), 'EUCLIDEAN') ASC LIMIT 1;

SELECT ID FROM VEC_TEST ORDER BY DISTANCE(V, STRING_TO_VECTOR('[0.0, 0.0]'), 'EUCLIDEAN') ASC;

SELECT ID FROM VEC_TEST ORDER BY DISTANCE(V, STRING_TO_VECTOR('[0.0, 0.0]'), 'EUCLIDEAN') DESC;

DROP TABLE VEC_TEST;

