-- echo Update MVCC Tests

create table mvcc_test(id int, value int);

insert into mvcc_test values(1, 100);
insert into mvcc_test values(2, 200);
insert into mvcc_test values(3, 300);

begin;
update mvcc_test set value = 150 where id = 1;
select * from mvcc_test;
commit;

begin;
update mvcc_test set value = 250 where id = 2;
rollback;

select * from mvcc_test;

begin;
update mvcc_test set value = 350 where id = 3;
select * from mvcc_test where id = 3;
commit;

select * from mvcc_test;

drop table mvcc_test;
