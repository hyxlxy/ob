-- echo EXPRESSION PRECISION TEST

create table exp_table(id int, col1 int, col2 int, col3 float, col4 float);
insert into exp_table values(3, 10, 5, 6.12, 400);

select col1, col2, col3, col4 from exp_table;
select col2*(-1) from exp_table;
select col2*(-1)+3 from exp_table;
select -(col2*(-1)+3) from exp_table;
select col3*5 from exp_table;
select col1+col3*5 from exp_table;
select col4+7 from exp_table;
select (col4+7)*(col1+col3*5) from exp_table;
select -(col2*(-1)+3)+(col4+7)*(col1+col3*5) from exp_table;

drop table exp_table;
