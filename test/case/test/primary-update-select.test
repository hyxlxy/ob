-- echo Update Select Tests

create table update_select_t1(id int, name char(20), score float);
create table update_select_t2(id int, bonus float);

insert into update_select_t1 values(1, 'Alice', 85.5);
insert into update_select_t1 values(2, 'Bob', 78.0);
insert into update_select_t1 values(3, 'Charlie', 92.5);

insert into update_select_t2 values(1, 5.0);
insert into update_select_t2 values(2, 3.0);
insert into update_select_t2 values(3, 8.0);

update update_select_t1 set score = (select bonus from update_select_t2 where update_select_t2.id = update_select_t1.id);

select * from update_select_t1;

update update_select_t1 set score = (select avg(bonus) from update_select_t2) where id = 1;

select * from update_select_t1;

drop table update_select_t1;
drop table update_select_t2;
