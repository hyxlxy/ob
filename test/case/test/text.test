create table text_table(id int, info text);
insert into text_table values (1,'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa');

select * from text_table;


insert into text_table values (2, '');
select * from text_table where id=2;

insert into text_table values (3, '');
update text_table set info = repeat('x', 65535) where id=3;
select length(info) from text_table where id=3;
-- 65536B should fail
insert into text_table values (4, repeat('y', 65536));

update text_table set info='short' where id=2;
delete from text_table where id=1;
insert into text_table values (5, 'zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz');
select * from text_table;
