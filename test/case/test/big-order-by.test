-- echo Big Order By Tests

create table big_order_t1(id int, col1 int, col2 float);
create table big_order_t2(id int, col3 char(10), col4 int);
create table big_order_t3(id int, col5 float, col6 int);

insert into big_order_t1 values(1, 10, 1.1);
insert into big_order_t1 values(2, 20, 2.2);
insert into big_order_t1 values(3, 30, 3.3);
insert into big_order_t1 values(4, 40, 4.4);
insert into big_order_t1 values(5, 50, 5.5);

insert into big_order_t2 values(1, 'A', 100);
insert into big_order_t2 values(2, 'B', 200);
insert into big_order_t2 values(3, 'C', 300);
insert into big_order_t2 values(4, 'D', 400);
insert into big_order_t2 values(5, 'E', 500);

insert into big_order_t3 values(1, 10.1, 1000);
insert into big_order_t3 values(2, 20.2, 2000);
insert into big_order_t3 values(3, 30.3, 3000);
insert into big_order_t3 values(4, 40.4, 4000);
insert into big_order_t3 values(5, 50.5, 5000);

select t1.id, t1.col1, t1.col2, t2.col3, t2.col4, t3.col5, t3.col6 
from big_order_t1 t1, big_order_t2 t2, big_order_t3 t3 
where t1.id = t2.id and t2.id = t3.id 
order by t1.col1, t2.col4, t3.col6;

drop table big_order_t1;
drop table big_order_t2;
drop table big_order_t3;
