UPDATE q2 SET id = 99 WHERE name = 'AliceAlice';
UPDATE q2 SET age = 99 WHERE id = 2;
UPDATE q2 SET name = 'Eve' WHERE id = 3; 
UPDATE q2 SET id = 100 WHERE id = 5;
UPDATE q2 SET name = 'FrankFrank' WHERE id = 6; 
UPDATE q2 SET age = 100 WHERE id = 7;

delete from q2 where id = 2;

CREATE VIEW qq1 AS SELECT t1.id AS id, t1.age AS age, t2.name AS name FROM q1 t1, q2 t2 WHERE t1.id = t2.id;

SELECT * FROM qq1;

SELECT COUNT(*) FROM qq1;