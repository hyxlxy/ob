### 2025-09-13 16:27:41.450
-- Test WHERE clause parts
### 2025-09-13 16:27:41.450
SELECT id FROM exp_table WHERE 2*col1 > 7;
### 2025-09-13 16:27:41.456
SELECT id FROM exp_table WHERE 2*col1*(col2+4) > 7;
### 2025-09-13 16:27:41.463
-- Test the full WHERE clause without division by zero
### 2025-09-13 16:27:41.463
SELECT id, 3*col1*(col2+5) FROM exp_table WHERE 2*col1*(col2+4)+9 > 7;
### 2025-09-13 16:31:40.222
-- Let's analyze the query step by step
### 2025-09-13 16:31:40.252
-- Let's break down the WHERE condition: 2*col1*(col2+4)+9/0 > 7
### 2025-09-13 16:31:40.252
-- Since 9/0 = 0 in our system, this becomes: 2*col1*(col2+4)+0 > 7
### 2025-09-13 16:31:40.253
-- Which simplifies to: 2*col1*(col2+4) > 7
### 2025-09-13 16:31:40.253
-- Calculate each part for each row
### 2025-09-13 16:31:40.253
SELECT id, col1, col2, 
### 2025-09-13 16:31:40.254
       (col2+4) as col2_plus_4,
### 2025-09-13 16:31:40.254
       2*col1 as two_times_col1,
### 2025-09-13 16:31:40.254
       2*col1*(col2+4) as left_side,
### 2025-09-13 16:31:40.255
       (2*col1*(col2+4) > 7) as condition_result
### 2025-09-13 16:31:40.255
FROM exp_table;
### 2025-09-13 16:31:40.255
-- Now let's see which rows should be selected
### 2025-09-13 16:31:40.256
SELECT id, 3*col1*(col2+5) as result_expr 
### 2025-09-13 16:31:40.256
FROM exp_table 
### 2025-09-13 16:31:40.256
WHERE 2*col1*(col2+4) > 7;
### 2025-09-13 16:31:57.924
-- Manual calculation for each row
### 2025-09-13 16:31:57.955
CREATE TABLE exp_table(id int, col1 int, col2 int, col3 float, col4 float);
### 2025-09-13 16:31:57.956
