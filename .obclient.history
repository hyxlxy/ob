### 2025-09-13 16:31:57.959
-- Show all data first
### 2025-09-13 16:31:57.960
SELECT id, col1, col2 FROM exp_table;
### 2025-09-13 16:31:57.975
-- Test the WHERE condition without division by zero: 2*col1*(col2+4) > 7
### 2025-09-13 16:31:57.975
SELECT id, col1, col2 FROM exp_table WHERE 2*col1*(col2+4) > 7;
### 2025-09-13 16:31:57.985
-- Test the SELECT expression: 3*col1*(col2+5)
